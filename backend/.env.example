# Backend environment variables
# Use your own long random values for secrets.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=
DB_HOST=
DB_PORT=4000
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
# DB_SSL is auto-enabled for *.tidbcloud.com hosts; set to 1 to force.
# DB_SSL=
# DB_SSL_CA=

# ---------------------------------------------------------------------------
# Auth (JWT)
# ---------------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# ---------------------------------------------------------------------------
# Upstream APIs
# ---------------------------------------------------------------------------
CHEAPSHARK_BASE=https://www.cheapshark.com/api/1.0

# ---------------------------------------------------------------------------
# Cloudflare R2 (used for thumbnail mirroring + admin asset storage)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
# Optional. Defaults to https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# R2_ENDPOINT=

# ---------------------------------------------------------------------------
# Spider <-> backend ingestion
# ---------------------------------------------------------------------------
SCRAPER_SECRET=replace-with-a-long-random-secret
