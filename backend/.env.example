# Backend environment variables
# Use your own long random values for secrets.

# Database (choose one approach)
DATABASE_URL=
DB_HOST=
DB_PORT=4000
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# Auth
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# CheapShark
CHEAPSHARK_BASE=https://www.cheapshark.com/api/1.0

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=

# Scraper ingestion secret
SCRAPER_SECRET=replace-with-a-long-random-secret
